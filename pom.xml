<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.interviewlab</groupId>
    <artifactId>java-interview-lab</artifactId>
    <version>1.0.0</version>
    <name>java-interview-lab</name>
    <description>
        A Java/Spring "Interview Laboratory" - working demonstrations (bad vs good, with tests)
        of the concurrency, transaction, JPA, Spring and design-pattern topics that come up in
        senior Java backend interviews.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <testcontainers.version>1.20.1</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Core Spring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <!-- Retry/CircuitBreaker/RateLimiter/Bulkhead/Timeout için - bkz. docs/resilience.md,
                 com.interviewlab.web.lab.resilience.* -->
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Security / JWT demo - bkz. docs/http-and-security.md, com.interviewlab.security.* -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Şemayı Hibernate ddl-auto=update yerine versiyonlu migration'lar yönetir -
                 hem dev Docker Postgres'i hem de test Testcontainers Postgres'i için tek,
                 tutarlı kaynak (src/main/resources/db/migration). -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Used only for the handful of pure in-memory Spring-context tests
                 (bean scopes, AOP, exceptions) where a real database brings nothing.
                 Every JPA/transaction/locking lab below runs against real PostgreSQL
                 via Testcontainers - see docs/README for why that distinction matters. -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>java-interview-lab</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Most test classes boot a full Spring context (Testcontainers Postgres);
                         reusing the fork lets Spring's test context cache avoid re-starting
                         that context per class, which matters a lot with 15+ test classes.
                         The pure-JUnit concurrency tests clean up their own threads/executors
                         instead of relying on fork isolation for that.

                         add-opens java.base/java.util=ALL-UNNAMED: gerçek, keşfedilmiş bir
                         gereklilik - JavaCoreTest'in HashMap treeification testi,
                         java.util.HashMap'in private `table` alanına reflection ile erişmeye
                         çalışırken InaccessibleObjectException aldı: java.base modülü,
                         java.util paketini PUBLİC API için export eder ama DEEP REFLECTION
                         (setAccessible) için OPEN etmez - bu, Java 9'un modül sisteminin
                         varsayılan davranışıdır ve bu proje `module-info.java` kullanmasa
                         BİLE JDK'nın kendi modülleri için geçerlidir (bkz.
                         docs/NOTES_CORRECTIONS.md reflection notu). -->
                    <argLine>-Xmx1536m --add-opens java.base/java.util=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
